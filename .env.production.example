# 운영 환경변수 예시 — ecobotapt.com
#
#   cp .env.production.example .env    (서버에서만. 저장소에 커밋 금지)
#
# .env 는 .gitignore 에 있습니다. 아래 값 중 SECRET_KEY 와 API 키는
# **반드시 새로 발급**하십시오. 예시 값을 그대로 쓰면 안 됩니다.

# ── Django ──
# 생성:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# 이 값이 바뀌면 기존 세션이 모두 로그아웃됩니다. 한번 정하면 바꾸지 마십시오.
DJANGO_SECRET_KEY=여기에_생성한_키를_붙여넣으십시오

DJANGO_DEBUG=False

# 접속에 실제로 쓰이는 이름을 전부 적습니다. 빠뜨리면 그 주소로 들어온
# 요청이 DisallowedHost(400)로 거부됩니다.
DJANGO_ALLOWED_HOSTS=ecobotapt.com,www.ecobotapt.com,127.0.0.1

# Caddy 가 앞단에 있으므로 켭니다. 프록시 없이 직접 노출할 때는 절대 켜지 마십시오.
DJANGO_BEHIND_PROXY=True

# 비워두면 ALLOWED_HOSTS 에서 https:// 형태로 자동 유도됩니다(권장).
#DJANGO_CSRF_TRUSTED_ORIGINS=https://ecobotapt.com,https://www.ecobotapt.com

# HTTPS 가 정상 동작하는 것을 확인한 **뒤에** 31536000 으로 올리십시오.
# 되돌리기 어렵습니다 — 브라우저가 그 기간 동안 HTTPS 를 강제합니다.
DJANGO_HSTS_SECONDS=0

# Caddy 가 이미 HTTP→HTTPS 리다이렉트를 합니다. 중복으로 켜지 마십시오.
DJANGO_SSL_REDIRECT=False

DJANGO_LOG_LEVEL=INFO

# ── 업로드 파일 ──
# 기본은 프로젝트 안의 media/ 입니다. Caddy 가 직접 서빙하게 바꾸려면
# 아래 두 값을 함께 켜십시오(deploy/Caddyfile.ecobotapt 하단 참고).
#DJANGO_MEDIA_ROOT=/var/www/ecobot/media
#DJANGO_SERVE_MEDIA=False

# ── DB ──
DB_ENGINE=mysql
DB_NAME=ecora
DB_USER=app_user
DB_PASSWORD=여기에_강한_비밀번호를_넣으십시오
DB_HOST=127.0.0.1
DB_PORT=3306

# ── RAG ──
RAG_SOURCE=db

# ⚠️ requirements-prod.txt 는 sentence-transformers 와 langchain 을 빼고
#    설치합니다. 아래 두 값을 local / langchain 으로 바꾸려면 그 패키지를
#    먼저 설치해야 합니다. 안 그러면 해당 요청에서만 에러가 납니다.
EMBEDDING_BACKEND=openai
RAG_PIPELINE=legacy

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# ── LLM ──
LLM_BACKEND=openai
OPENAI_MODEL=gpt-4o-mini
# ⚠️ 배포 전용 키를 따로 발급하고, OpenAI 대시보드에서 **월 사용 한도**를
#    반드시 설정하십시오. 회원가입이 열려 있고 코드에 rate limit 이 없어
#    공개되는 순간 이 키가 사실상 외부에 노출된 것과 같습니다.
OPENAI_API_KEY=sk-...

# ── 검색 파라미터 (개발과 동일) ──
# ── 사용자별 하루 질문 한도 ──
# 질문 1건마다 임베딩 + LLM 호출이 나갑니다. 회원가입이 열려 있으므로
# 이게 없으면 계정 하나로 API 비용을 무제한 태울 수 있습니다.
# 0 이면 무제한. superuser 는 기본적으로 면제됩니다.
CHAT_DAILY_LIMIT=50
CHAT_DAILY_LIMIT_EXEMPT_STAFF=True

RAG_TOP_K=4
RAG_TOP_K_GUIDE=3
RAG_TOP_K_LAW=2
RAG_TOP_K_REGION=2
RAG_TOP_K_COMMON=1
RAG_MIN_SCORE=0.3
CHUNK_SIZE=700
CHUNK_OVERLAP=100
CHAT_HISTORY_TURNS=3
QUESTION_CLUSTER_THRESHOLD=0.85
