# Ecobot 4차(Django) 환경설정 예시.
# `copy .env.example .env` (Windows) / `cp .env.example .env` 후 수정하십시오.
# 퀵스타트(A절): DB_ENGINE=sqlite3 / RAG_SOURCE=files / EMBEDDING_BACKEND=hash
# 실사용(B절):   DB_ENGINE=mysql   / RAG_SOURCE=db    / EMBEDDING_BACKEND=openai

# ── Django ──
DJANGO_SECRET_KEY=dev-only-secret-key-change-me
DJANGO_DEBUG=True
# 테스트 스크립트(Client)를 쓰려면 testserver 를 포함해야 합니다 (HANDOFF 4번)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# ── DB ──  sqlite3 이면 아래 DB_NAME~DB_PORT 는 무시됩니다
DB_ENGINE=mysql
DB_NAME=ecora
DB_USER=app_user
DB_PASSWORD=app_password
DB_HOST=127.0.0.1
DB_PORT=3306

# ── RAG 문서 소스 ──  db=documents 테이블 / files=data/ 폴더 직접 읽기
# (어느 모드든 사용자 업로드(manual)는 DB 에서 읽습니다 — RUN.md A절 버그 수정 참고)
RAG_SOURCE=db

# ── 임베딩 ──  openai | gemini | local | hash
# hash 는 파이프라인 검증용입니다. 품질 지표·'자료없음' 판정에 쓰지 마십시오 (HANDOFF 4번).
EMBEDDING_BACKEND=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH=100
GEMINI_BATCH_DELAY=2.0
GEMINI_RETRY_WAIT=30
LOCAL_EMBEDDING_DIMENSION=384

# ── LLM ──  openai | gemini  (키가 없으면 "[LLM 미연결]" 안내로 폴백 — 정상)
LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── 검색 파이프라인 ──  legacy(기본, 측정치 93.3% 의 경로) | langchain(영문 경로 필요)
RAG_PIPELINE=legacy

# ── 검색 파라미터 ──  백엔드를 바꾸면 RAG_MIN_SCORE 는 measure_threshold 로 재측정
RAG_TOP_K=4
RAG_TOP_K_GUIDE=3
RAG_TOP_K_LAW=2
RAG_TOP_K_REGION=2
RAG_TOP_K_COMMON=1
RAG_MIN_SCORE=0.3
RAG_MIN_SCORE_LOCAL=0.05

# ── 청킹 · 대화 ──
CHUNK_SIZE=700
CHUNK_OVERLAP=100
CHAT_HISTORY_TURNS=3
QUESTION_CLUSTER_THRESHOLD=0.85
