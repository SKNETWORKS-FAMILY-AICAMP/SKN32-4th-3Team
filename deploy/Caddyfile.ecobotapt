# ── EcoBot (ecobotapt.com) ──
# /etc/caddy/Caddyfile 의 **맨 끝에 그대로 이어붙이십시오**.
# 기존 사이트 블록은 건드리지 않습니다.
#
# 적용:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy      # 무중단 — 기존 사이트는 끊기지 않습니다
#
# ⚠️ 반드시 DNS A 레코드가 먼저 퍼진 뒤에 reload 하십시오.
#    dig +short ecobotapt.com  →  이 서버의 공인 IP 가 나와야 합니다.
#    DNS 가 없는 상태로 reload 하면 Let's Encrypt 검증이 실패하고,
#    실패를 반복하면 발급 한도에 걸려 몇 시간 막힙니다.

# www 는 apex 로 넘깁니다. 주소를 하나로 통일해야 세션 쿠키와 CSRF origin 이
# 갈라지지 않습니다(www 로 로그인한 뒤 apex 로 가면 로그아웃된 것처럼 보입니다).
www.ecobotapt.com {
	redir https://ecobotapt.com{uri} permanent
}

ecobotapt.com {
	reverse_proxy 127.0.0.1:8000 {
		# Caddy 기본 동작은 클라이언트가 보낸 X-Forwarded-For **뒤에 덧붙이는**
		# 것이라, 그대로 두면 위조값이 앞에 오게 됩니다. 실제 주소로 덮어씁니다.
		# (같은 Caddyfile 의 다른 사이트 블록과 같은 이유)
		#
		# ⚠️ `caddy validate` 가 "Unnecessary header_up X-Forwarded-For" 라고
		#    경고하는데, 무시해도 되는 경고입니다. Caddy 는 "어차피 헤더를
		#    전달한다"는 뜻으로 말하는 것이고, 여기서 하려는 것은 전달이 아니라
		#    **위조값 제거**입니다. 지금 Django 는 XFF 를 읽지 않지만, 남겨둔
		#    위험(rate limit 부재 — docs/decisions/0001 참고)을 IP 기준으로
		#    막게 되는 순간 이 한 줄이 곧바로 의미를 갖습니다.
		header_up X-Forwarded-For {remote_host}

		# 문서 업로드는 그 요청 안에서 FAISS 인덱스를 통째로 다시 만듭니다.
		# gunicorn 쪽 timeout=180 과 짝을 맞춰 둡니다. 한쪽만 짧으면
		# 그쪽에서 먼저 끊겨 업로드가 실패합니다.
		transport http {
			response_header_timeout 180s
			read_timeout 180s
		}
	}

	# 업로드 상한. 단지 규정 PDF 를 올리므로 넉넉히 둡니다.
	request_body {
		max_size 100MB
	}

	encode zstd gzip

	# 로그는 journald 로 (Caddy 기본).  journalctl -u caddy -f
}

# ── 참고: /media/ 를 Caddy 가 직접 서빙하고 싶다면 ──
# 지금은 Django 가 내보냅니다(config/urls.py). 더 빠르게 하려면:
#
#   1. sudo mkdir -p /var/www/ecobot/media
#      sudo chown <앱계정>:www-data /var/www/ecobot/media && sudo chmod 750 ...
#      (caddy 사용자는 www-data 그룹에 속해 있습니다)
#   2. .env 에  DJANGO_MEDIA_ROOT=/var/www/ecobot/media
#               DJANGO_SERVE_MEDIA=False
#   3. 위 ecobotapt.com 블록 안에 아래를 추가:
#
#        handle_path /media/* {
#        	root * /var/www/ecobot/media
#        	file_server
#        }
#
# 앱 계정 홈이 0750 이면 caddy 사용자가 통과하지 못하므로
# media 를 프로젝트 안에 둔 채로는 이 방법을 쓸 수 없습니다.
